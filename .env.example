# ---- App ----
APP_NAME=StockSense
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
# Absolute URL of the public/ folder, no trailing slash. Used for links inside e-mails.
# Example (XAMPP): http://localhost/inventory-management-system/public
APP_URL=http://localhost/inventory-management-system/public
# Long random string (used to hash OTPs). Change it!
APP_KEY=change-me-to-a-long-random-string
SESSION_IDLE_MINUTES=120

# Needed to sign up as Inventory Manager. Staff sign up without it.
MANAGER_REGISTRATION_KEY=change-this-manager-key

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stocksense_ims
DB_USER=root
DB_PASS=

# ---- Mail (PHPMailer) ----
# MAIL_DRIVER=smtp sends real mail. MAIL_DRIVER=log only writes mails to storage/logs/mail.log (local testing).
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls (port 587) | ssl (port 465) | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-address@gmail.com
# Gmail: create an "App Password" (2-step verification must be on). Do NOT use your normal password.
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME=StockSense IMS
